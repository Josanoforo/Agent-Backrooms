# Copy to /etc/agent-escape-room.env with mode 0600; fill secrets locally on VM.
VULTR_INFERENCE_KEY=
ESCAPE_MODEL=
ESCAPE_OPERATOR_TOKEN=
ESCAPE_DB=/var/lib/agent-escape-room/runs.sqlite3
ESCAPE_DOCKER_IMAGE=python:3.12-slim
ESCAPE_MAX_RUNS=10
ESCAPE_MAX_CALLS=40
ESCAPE_MAX_OUTPUT_TOKENS=40960
ESCAPE_RATE_LIMIT_PER_MINUTE=5
ESCAPE_TRUSTED_PROXIES=127.0.0.1/32,::1/128
ESCAPE_CLEANUP_ON_STARTUP=1

# Explicit input limit; never truncates conversation. Valid range2000..40000.
ESCAPE_PROVIDER_INPUT_LIMIT_CHARS=40000
# Set real only where the provider is actual Vultr inference; fixtures must declare fixture.
ESCAPE_EVIDENCE_ORIGIN=unknown
