[Unit]
Description=Agent Backrooms controller
After=docker.service network-online.target
Requires=docker.service
Wants=network-online.target

[Service]
Type=simple
User=escape
Group=escape
SupplementaryGroups=docker
WorkingDirectory=/opt/agent-escape-room/current
EnvironmentFile=/etc/agent-escape-room.env
ExecStart=/opt/agent-escape-room/venv/bin/uvicorn services.agent.main:app --host 127.0.0.1 --port 8000 --workers 1 --no-proxy-headers
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/agent-escape-room

[Install]
WantedBy=multi-user.target
