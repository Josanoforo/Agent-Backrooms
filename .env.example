# Agent Backrooms — plantilla P5. No contiene credenciales. Las variables ESCAPE_* conservan el nombre de trabajo escape-room.
# La aplicación lee variables de entorno; este archivo NO se carga automáticamente.
VULTR_INFERENCE_KEY=
ESCAPE_OPERATOR_TOKEN=
ESCAPE_MODEL=glm-5.3-flash
ESCAPE_DB=escape-room.sqlite3
ESCAPE_EVIDENCE_ORIGIN=unknown
ESCAPE_DOCKER_IMAGE=python:3.12-slim
# Límite explícito 2000..40000 caracteres; jamás se trunca una conversación.
ESCAPE_PROVIDER_INPUT_LIMIT_CHARS=40000
# Cuotas acumuladas de la base. Reiniciar NO devuelve cuotas.
ESCAPE_MAX_RUNS=5
ESCAPE_MAX_CALLS=40
ESCAPE_MAX_OUTPUT_TOKENS=40960
ESCAPE_RATE_LIMIT_PER_MINUTE=5
# Añadir tarifa fechada y del modelo exacto antes de estimar coste real.
# ESCAPE_USAGE_RATE_JSON={"model":"...","input_per_million":0.0,"output_per_million":0.0,"effective_date":"YYYY-MM-DD","source":"..."}
# Comprobar un subconjunto real de habitaciones antes de iniciar:
# python scripts/p5_config_check.py --levels workflow --cap-usd 0.25 --require-secrets --require-cost-estimate --strict
